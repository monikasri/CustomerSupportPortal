@{
    ViewData["Title"] = "Agent Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Agent Dashboard</h1>
        <p class="text-muted mb-0">Overview of requests assigned to you and quick actions.</p>
    </div>
    <div>
        <a class="btn btn-outline-secondary" href="#" role="button">Settings</a>
    </div>
</div>

<!-- Summary cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Assigned Requests</h6>
                <h3 id="assignedRequests" class="mb-0">0</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Open Requests</h6>
                <h3 id="openRequests" class="mb-0">0</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">In Progress</h6>
                <h3 id="inProgressRequests" class="mb-0">0</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Resolved Requests</h6>
                <h3 id="resolvedRequests" class="mb-0">0</h3>
            </div>
        </div>
    </div>
</div>

<!-- Filters and Search -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input id="tableSearch" type="search" class="form-control" placeholder="Search requests">
                </div>
            </div>

            <div class="col-6 col-md-3">
                <select id="statusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option>Open</option>
                    <option>Pending</option>
                    <option>In Progress</option>
                    <option>Resolved</option>
                    <option>Closed</option>
                </select>
            </div>

            <div class="col-6 col-md-3">
                <select id="priorityFilter" class="form-select">
                    <option value="">All Priorities</option>
                    <option>High</option>
                    <option>Medium</option>
                    <option>Low</option>
                </select>
            </div>

            <div class="col-12 col-md-2 text-md-end">
                <button id="refreshBtn" class="btn btn-outline-primary">Refresh</button>
            </div>
        </div>
    </div>
</div>

<!-- DataTable -->
<div class="card table-container">
    <div class="card-body p-3">
        <div class="table-responsive">
            <table id="AgentRequests" class="table table-hover align-middle" style="width:100%">
                <thead>
                    <tr>
                        <th>Request ID</th>
                        <th>Subject</th>
                        <th>Customer Name</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- sample/static rows will be injected by JS -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- View Modal -->
<div class="modal fade" id="viewRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Request Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <dl class="row">
                    <dt class="col-sm-3">Request ID</dt>
                    <dd class="col-sm-9" id="modalRequestId">-</dd>

                    <dt class="col-sm-3">Subject</dt>
                    <dd class="col-sm-9" id="modalSubject">-</dd>

                    <dt class="col-sm-3">Customer</dt>
                    <dd class="col-sm-9" id="modalCustomer">-</dd>

                    <dt class="col-sm-3">Priority</dt>
                    <dd class="col-sm-9" id="modalPriority">-</dd>

                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9" id="modalStatus">-</dd>

                    <dt class="col-sm-3">Created</dt>
                    <dd class="col-sm-9" id="modalCreated">-</dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // Sample static data for UI preview
            var sampleData = [
                { requestId: 101, subject: 'Cannot login', customerName: 'Alice Johnson', priority: 'High', status: 'Open', createdDate: '2026-09-10' },
                { requestId: 102, subject: 'Error on checkout', customerName: 'Bob Smith', priority: 'Medium', status: 'In Progress', createdDate: '2026-09-11' },
                { requestId: 103, subject: 'Feature request: export', customerName: 'Carol White', priority: 'Low', status: 'Pending', createdDate: '2026-09-12' },
                { requestId: 104, subject: 'Unable to reset password', customerName: 'David Green', priority: 'High', status: 'Resolved', createdDate: '2026-09-13' },
                { requestId: 105, subject: 'UI glitch on mobile', customerName: 'Eve Black', priority: 'Low', status: 'Open', createdDate: '2026-09-14' }
            ];

            function priorityBadge(p) {
                if (!p) return '<span class="badge bg-secondary">Unknown</span>';
                var t = p.toLowerCase();
                if (t === 'high') return '<span class="badge bg-danger">' + p + '</span>';
                if (t === 'medium') return '<span class="badge bg-warning text-dark">' + p + '</span>';
                if (t === 'low') return '<span class="badge bg-success">' + p + '</span>';
                return '<span class="badge bg-secondary">' + p + '</span>';
            }

            function statusBadge(s) {
                if (!s) return '<span class="badge bg-secondary">Unknown</span>';
                var t = s.toLowerCase();
                if (t.indexOf('open') !== -1) return '<span class="badge bg-primary">' + s + '</span>';
                if (t.indexOf('pending') !== -1) return '<span class="badge bg-warning text-dark">' + s + '</span>';
                if (t.indexOf('in progress') !== -1 || t.indexOf('progress') !== -1) return '<span class="badge bg-info text-dark">' + s + '</span>';
                if (t.indexOf('resolved') !== -1 || t.indexOf('closed') !== -1) return '<span class="badge bg-success">' + s + '</span>';
                return '<span class="badge bg-secondary">' + s + '</span>';
            }

            // Initialize DataTable with client-side data
            var table = null;
            $(document).ready(function () {
                table = $('#AgentRequests').DataTable({
                    data: sampleData,
                    columns: [
                        { data: 'requestId' },
                        { data: 'subject' },
                        { data: 'customerName' },
                        { data: 'priority', render: function (d) { return priorityBadge(d); } },
                        { data: 'status', render: function (d) { return statusBadge(d); } },
                        { data: 'createdDate' },
                        { data: null, orderable: false, searchable: false, render: function (data, type, row) {
                                return '<button class="btn btn-sm btn-primary view-btn" data-id="' + row.requestId + '">View</button>';
                            }
                        }
                    ],
                    pageLength: 5,
                    lengthChange: false,
                    responsive: true,
                    info: true,
                    autoWidth: false
                });

                // populate counts
                updateSummaryCounts();

                // Search box
                $('#tableSearch').on('input', function () {
                    table.search(this.value).draw();
                });

                // Filters
                $('#statusFilter').on('change', function () {
                    var val = $(this).val();
                    table.column(4).search(val).draw();
                });
                $('#priorityFilter').on('change', function () {
                    var val = $(this).val();
                    table.column(3).search(val).draw();
                });

                $('#refreshBtn').on('click', function () {
                    // in real app, would reload from server
                    table.clear().rows.add(sampleData).draw();
                    updateSummaryCounts();
                });

                // View button handler
                $('#AgentRequests tbody').on('click', '.view-btn', function () {
                    var id = $(this).data('id');
                    var row = sampleData.find(function (r) { return r.requestId == id; });
                    if (row) {
                        $('#modalRequestId').text(row.requestId);
                        $('#modalSubject').text(row.subject);
                        $('#modalCustomer').text(row.customerName);
                        $('#modalPriority').html(priorityBadge(row.priority));
                        $('#modalStatus').html(statusBadge(row.status));
                        $('#modalCreated').text(row.createdDate);
                        var modal = new bootstrap.Modal(document.getElementById('viewRequestModal'));
                        modal.show();
                    }
                });
            });

            function updateSummaryCounts() {
                var assigned = sampleData.length; // static sample assumes all are assigned
                var open = sampleData.filter(function (r) { return /open/i.test(r.status); }).length;
                var inProgress = sampleData.filter(function (r) { return /in progress/i.test(r.status) || /progress/i.test(r.status); }).length;
                var resolved = sampleData.filter(function (r) { return /resolved|closed/i.test(r.status); }).length;

                $('#assignedRequests').text(assigned);
                $('#openRequests').text(open);
                $('#inProgressRequests').text(inProgress);
                $('#resolvedRequests').text(resolved);
            }
        })();
    </script>
}
